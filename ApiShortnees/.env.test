# Entorno de tests. Symfony ignora .env.local aqui a proposito: los tests deben
# dar el mismo resultado en cualquier maquina. Por eso todo lo que necesiten
# tiene que estar declarado en este fichero o en .env.test.local.
#
# Este fichero SI se versiona: no puede llevar ningun secreto real.

KERNEL_CLASS='App\Kernel'

# El .env versionado trae APP_DEBUG=0 porque vale para produccion. En tests
# hace falta lo contrario: sin debug, Symfony no comprueba si el contenedor
# compilado esta obsoleto, y un cambio en el constructor de un servicio da un
# 500 incomprensible hasta que se limpia la cache a mano.
APP_DEBUG=1
APP_SECRET='no-es-un-secreto-solo-para-tests'

# Par de claves propio de los tests, generado en cada maquina y en el CI con:
#   php bin/console lexik:jwt:generate-keypair --env=test
# Nunca se versiona (ver .gitignore) y no vale fuera de la suite, asi que la
# passphrase puede ir aqui a la vista.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/test-private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/test-public.pem
JWT_PASSPHRASE=passphrase-de-pruebas

# DATABASE_URL no se define aqui. Sale de .env.test.local en local y de una
# variable de entorno en el CI. Doctrine le anade el sufijo _test (ver el
# bloque when@test de doctrine.yaml), asi que la base atacada es webtools_test
# aunque la URL apunte a webtools.
